{
  "name": "kotonoha-promo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ことのは のプロモーション映像（Remotion）",
  "scripts": {
    "assets": "node --env-file=../.env.local scripts/assets.mjs",
    "narration": "node --env-file=../.env.local scripts/narration.mjs",
    "music": "node scripts/marks.mjs | python scripts/music.py public/sound && node scripts/marks.mjs --narrated | python scripts/music.py public/sound --music music-narration.wav",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs out/stills",
    "render": "remotion render src/index.ts Promo out/kotonoha-promo.mp4",
    "render:narration": "remotion render src/index.ts PromoNarration out/kotonoha-promo-narration.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "^19",
    "esbuild": "0.28.1",
    "typescript": "^5"
  }
}
