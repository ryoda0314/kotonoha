# ことのあめ's Supabase project (its accounts; the record is kept in en_records, read and written as the learner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ことのあめ's address, for making an account or resetting a password (default https://polylinga.vercel.app)
NEXT_PUBLIC_KOTONOAME_URL=
# Optional: ことのあめ's Google OAuth client, once this app's addresses are among its authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OpenAI: corrections and replies (/api/turn, /api/other), speech (/api/say, scripts/generate-audio.mjs) and hearing
# what was said (/api/hear)
OPENAI_API_KEY=
# Optional: another model for corrections and replies (default gpt-5.5), another transcription model, and the
# whole-service ceiling of sentences per server instance per day (default 5000)
TALK_MODEL=
HEAR_MODEL=
TURNS_PER_DAY=

# Signs the English the app's AI wrote, so /api/say voices only that (any long random string)
SAY_SECRET=

# Vertex AI: Gemini text-to-speech for the friends with a Google voice (Leo, Nora), in ことのあめ's project. Without it
# their replies fall back to OpenAI voices, and scripts/generate-audio.mjs cannot voice their lines
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=
